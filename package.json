    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "prettier": "^3.9.6",
    "sass": "^1.103.1",
    "terser": "^5.51.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
